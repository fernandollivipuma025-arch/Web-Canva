  <style>
    :root {
      --ink: #f6f5ff;
      --muted: #b9b8d5;
      --panel: rgba(10, 12, 38, 0.76);
      --electric: #42e8ff;
      --violet: #8b5cf6;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      width: 100%;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      margin: 0;

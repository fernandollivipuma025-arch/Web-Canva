      border-color: rgba(66, 232, 255, .75);
      box-shadow: 0 22px 45px rgba(0, 0, 0, .36), 0 0 28px rgba(66, 232, 255, .12);
    }

    .setup-image {
      width: 100%;
      height: 210px;
      object-fit: cover;
      transition: transform .45s ease, filter .45s ease;
    }

    .setup-card:hover .setup-image {
      transform: scale(1.07);

      box-shadow: 0 0 14px #42e8ff;
    }

    @keyframes drift {
      from { background-position: 0 0, 20px 30px, 0 50px, 40px 0; }
      to { background-position: 170px 150px, -220px 270px, 200px -160px, -230px 260px; }
    }

    @keyframes slowZoom {
      from { transform: scale(1.04); }
      to { transform: scale(1.15); }
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    @keyframes enter {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 900px) {

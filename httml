    .brand-mark {
      font-family: "Space Mono", monospace;
      letter-spacing: .12em;
      text-shadow: 0 0 22px rgba(66, 232, 255, .75);
    }

    .nav-link {
      border: 1px solid transparent;
      color: var(--muted);
      transition: color .25s ease, background .25s ease, border-color .25s ease;
    }

    .nav-link:hover,
    .nav-link.active {
      color: #fff;
      border-color: rgba(66, 232, 255, .55);
      background: rgba(66, 232, 255, .11);
    }

    .page-view {
      display: none;
      width: 100%;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh) - 78px);
      animation: enter .55s ease both;
    }

    .page-view.active { display: flex; }

    .hero-stage {
      position: relative;
      overflow: hidden;
      background: #07091c;
    }

    .hero-photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: .72;
      filter: saturate(1.15) contrast(1.1);
      transform: scale(1.04);
      animation: slowZoom 14s ease-in-out infinite alternate;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;

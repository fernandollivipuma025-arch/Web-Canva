      outline: 3px solid #42e8ff;
      outline-offset: 4px;
    }

    .app-shell {
      width: 100%;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }

    .star-field {
      position: fixed;
      inset: 0;
      z-index: -1;

  <script>
    const views = {
      home: document.getElementById("home-page"),
      setups: document.getElementById("setups-page")
    };

    const navButtons = document.querySelectorAll("[data-page-target]");
    const dots = {
      home: document.getElementById("dot-home"),
      setups: document.getElementById("dot-setups")
    };

    function changePage(pageName, moveFocus = true) {
      Object.entries(views).forEach(([name, view]) => {
        view.classList.toggle("active", name === pageName);
      });

      navButtons.forEach((button) => {
        const isActive = button.dataset.pageTarget === pageName;
        button.classList.toggle("active", isActive);
        if (button.classList.contains("nav-link")) {
          if (isActive) button.setAttribute("aria-current", "page");
          else button.removeAttribute("aria-current");
        }
      });

      Object.entries(dots).forEach(([name, dot]) => {
        dot.classList.toggle("active", name === pageName);
      });

      if (moveFocus) {
        const heading = pageName === "home"
          ? document.getElementById("hero-title")
          : document.getElementById("catalog-title");
        heading.focus({ preventScroll: true });
      }
    }

    navButtons.forEach((button) => {
      button.addEventListener("click", () => changePage(button.dataset.pageTarget));
    });

    lucide.createIcons();
  </script>
